---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import AuthorName from './AuthorName.astro';
import Headline from './Headline.astro';
import { formatDate } from '../lib/dates';
import { makeExcerpt } from '../lib/excerpt';
import { url } from '../lib/paths';

interface Props {
	article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { title, date, image, imageAlt, excerpt, author, category, advice, cartoon } = article.data;
const href = url(`/articles/${article.id}/`);
const excerptText = makeExcerpt(article.body, excerpt);
---

<li class:list={['article-card', { 'has-image': !!image, advice }]}>
	{
		image && (
			<div class="article-card-image">
				<a href={href} tabindex="-1" aria-hidden="true">
					<Image src={image} alt={imageAlt ?? title} width={560} height={560} />
				</a>
			</div>
		)
	}
	<div class="article-card-body">
		{!cartoon && <p class="article-card-kicker">{category}</p>}
		<h2 class="article-card-title"><a href={href}><Headline article={article} /></a></h2>
		{excerptText && <p class="article-card-excerpt">{excerptText}</p>}
		<p class="article-card-meta">
			{author && <AuthorName name={author} />}
			{author && ' · '}
			{formatDate(date)}
		</p>
	</div>
</li>
