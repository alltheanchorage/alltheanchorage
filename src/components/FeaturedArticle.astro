---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import AuthorName from './AuthorName.astro';
import Headline from './Headline.astro';
import { formatDate } from '../lib/dates';
import { url } from '../lib/paths';

interface Props {
	article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { title, date, image, imageAlt, author, category, advice, cartoon } = article.data;
const href = url(`/articles/${article.id}/`);
---

<div class:list={['featured-article', { advice, cartoon }]}>
	{!cartoon && <h2 class="featured-article-title"><a href={href}>{title}</a></h2>}
	{
		image && (
			<div class="featured-article-image">
				<a href={href} tabindex="-1" aria-hidden="true">
					<Image src={image} alt={imageAlt ?? title} width={1200} />
				</a>
			</div>
		)
	}
	{
		cartoon ? (
			<h2 class="cartoon-caption"><a href={href}><Headline article={article} /></a></h2>
		) : (
			<p class="article-card-kicker">{category}</p>
		)
	}
	<p class="article-card-meta">
		{author && <AuthorName name={author} />}
		{author && ' · '}
		{formatDate(date)}
	</p>
</div>
