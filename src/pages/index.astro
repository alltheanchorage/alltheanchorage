---
import { getCollection } from 'astro:content';
import ArticleCard from '../components/ArticleCard.astro';
import FeaturedArticle from '../components/FeaturedArticle.astro';
import Layout from '../layouts/Layout.astro';
import { articleMonth, articleYear } from '../lib/dates';
import { sortArticlesForDisplay } from '../lib/sortArticles';

const allArticles = sortArticlesForDisplay(await getCollection('articles', ({ data }) => !data.draft));

// Home page only shows the most recent year/month that has any published
// articles; archive pages still show everything for their period.
const mostRecent = allArticles[0];
const articles = mostRecent
	? allArticles.filter(
			(article) =>
				articleYear(article.data.date) === articleYear(mostRecent.data.date) &&
				articleMonth(article.data.date) === articleMonth(mostRecent.data.date),
		)
	: [];

// `articles` is already sorted (main, then order, then date), so every
// article marked `main` gets the hero layout, in priority order.
const featured = articles.filter((article) => article.data.main);
const rest = articles.filter((article) => !article.data.main);
---

<Layout title="Home">
	<div class="container">
		{
			articles.length === 0 ? (
				<p class="empty-state">No articles published yet. Check back soon.</p>
			) : (
				<>
					{featured.map((article) => (
						<FeaturedArticle article={article} />
					))}
					<ul class="article-list">
						{rest.map((article) => (
							<ArticleCard article={article} />
						))}
					</ul>
				</>
			)
		}
	</div>
</Layout>
