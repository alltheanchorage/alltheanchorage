---
import { getCollection } from 'astro:content';
import ArticleCard from '../components/ArticleCard.astro';
import FeaturedArticle from '../components/FeaturedArticle.astro';
import Layout from '../layouts/Layout.astro';
import { articleMonth, articleYear } from '../lib/dates';
import { sortArticlesForDisplay } from '../lib/sortArticles';

const allArticles = sortArticlesForDisplay(await getCollection('articles', ({ data }) => !data.draft));

// Home page only shows the most recent year/month that has any published
// articles; archive pages still show everything for their period.
const mostRecent = allArticles[0];
const articles = mostRecent
	? allArticles.filter(
			(article) =>
				articleYear(article.data.date) === articleYear(mostRecent.data.date) &&
				articleMonth(article.data.date) === articleMonth(mostRecent.data.date),
		)
	: [];

// `articles` is already sorted by order (then date). Walk it in that order,
// giving `main` articles the hero layout and grouping consecutive regular
// articles into card lists between them.
type Block =
	| { kind: 'hero'; article: (typeof articles)[number] }
	| { kind: 'list'; articles: typeof articles };
const blocks: Block[] = [];
for (const article of articles) {
	const last = blocks.at(-1);
	if (article.data.main) blocks.push({ kind: 'hero', article });
	else if (last?.kind === 'list') last.articles.push(article);
	else blocks.push({ kind: 'list', articles: [article] });
}
---

<Layout title="Home">
	<div class="container">
		{
			articles.length === 0 ? (
				<p class="empty-state">No articles published yet. Check back soon.</p>
			) : (
				blocks.map((block) =>
					block.kind === 'hero' ? (
						<FeaturedArticle article={block.article} />
					) : (
						<ul class="article-list">
							{block.articles.map((article) => (
								<ArticleCard article={article} />
							))}
						</ul>
					),
				)
			)
		}
	</div>
</Layout>
